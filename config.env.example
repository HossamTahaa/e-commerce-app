# Template for config.env - THIS file is committed to git, config.env is NOT.
# After cloning the repo: copy this file to "config.env" and fill in real values.
#
#   Windows (PowerShell):  Copy-Item config.env.example config.env
#   Mac / Linux:           cp config.env.example config.env

PORT=8000
NODE_ENV=development

# Local MongoDB
DB_URL=mongodb://127.0.0.1:27017/ecommerce

# Or MongoDB Atlas - never commit the real username/password
# DB_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ecommerce?retryWrites=true&w=majority

BASE_URL=http://localhost:8000/api/v1
